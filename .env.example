# Environment Configuration for LegalLens
# Copy this file to .env and fill in the values

# Application
APP_ENV=development
APP_NAME=legallens
APP_VERSION=0.1.0
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql+psycopg://legallens:legallens@localhost:5432/legallens

# Redis (optional for MVP)
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO for development)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=legallens-private
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# LLM Provider
LLM_API_BASE=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT=30
LLM_MAX_RETRIES=1

# Embedding Provider
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Upload Limits
MAX_UPLOAD_SIZE_MB=20
MAX_PDF_PAGES=100

# Retention
DOCUMENT_TTL_HOURS=24
CHAT_TTL_HOURS=24

# OCR
OCR_ENABLED=true

# RAG
EXTERNAL_RAG_ENABLED=false

# Security
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
RATE_LIMIT_PER_MINUTE=30
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Logging
LOG_LEVEL=INFO

# Monitoring (optional)
SENTRY_DSN=
PROMETHEUS_ENABLED=false
