# ============================================================
# LegalLens - Root .gitignore
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Environment & secrets ----
.env
.env.*
!.env.example

# ---- Database & uploads ----
*.db
*.sqlite
*.sqlite3
uploads/
legallens.db

# ---- Test / scratch files (root-level) ----
test_*.py
test_*.pdf
dummy.pdf
sample_*.pdf
create_pdf.py
generate_test_msa_pdf.py

# ---- Node / Next.js ----
node_modules/
.next/
/out/
/build
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts

# ---- IDE / OS ----
.DS_Store
*.pem
.idea/
.vscode/
Thumbs.db

# ---- Docker volumes / local data ----
pgdata/
redisdata/
